# --- Application ---
APP_ENV=local
APP_NAME=Learner
APP_DEBUG=true
SECRET_KEY=change-me-in-production

# --- Database ---
# SQLite (default, no setup). For Postgres: postgresql+asyncpg://user:pass@localhost/learner
DATABASE_URL=sqlite+aiosqlite:///./learner.db

# --- Model provider ---
# none        = deterministic, no model, no key (default; always works)
# claude_code = premium answers drafted/verified by a running Claude Code worker session
# anthropic   = reserved; requires ANTHROPIC_API_KEY (off by default, not needed)
MODEL_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

MAX_MODEL_RETRIES=2
MAX_PIPELINE_ATTEMPTS=2
MODEL_TIMEOUT_SECONDS=60

# --- Ingestion ---
UPLOAD_DIRECTORY=./uploads
MAX_UPLOAD_SIZE_MB=25

# --- Retrieval ---
RETRIEVAL_LIMIT=8
RETRIEVAL_MIN_SCORE=0.0

# --- Server ---
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
DEMO_USER_ID=00000000-0000-0000-0000-000000000001
